public/dataset.py

# python
.venv/
__pycache__/

# model checkpoints — assist_model.pt runs to hundreds of MB, well past
# GitHub's 100 MB per-file limit
*.pt
*.pt.tmp

# exported datasets
*.zip
/dataset/

# scratch copy of the tree, used for isolated test runs
.isotest/

# os / editor cruft
.DS_Store
Thumbs.db
*.swp
